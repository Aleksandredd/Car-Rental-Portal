# Copy this file to .env and fill in the values.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True while developing, False otherwise
DEBUG=True

# The external car rental REST API
API_BASE_URL=https://rentcar.stepprojects.ge

# Optional: Mapbox public token (pk....) for the map on the car page.
# Leave empty to hide the map.
MAPBOX_TOKEN=
